# General
VIDEO_PATH=/mnt/c/trace.moe/video/
TRACE_API_SALT=YOUR_TRACE_API_SALT   # set a random string of at least 16 bytes for security
# SERVER_PORT=3001         # (Default: arbitrary unused port by OS)
# SERVER_ADDR=127.0.0.1    # (Default: 0.0.0.0 for IPv4 or :: for IPv6)
# MAX_WORKER=4             # (Default: 1) max number of worker process for has and load jobs
# MEDIA_QUEUE=8            # (Default: logical core count) min: 1, set to Infinity to disable
# SEARCH_QUEUE=8           # (Default: logical core count) min: 1, set to Infinity to disable
# SCAN_INTERVAL=60         # (Default: 60) scan interval in seconds, set to 0 or Infinity to disable
# IMAGE_PROXY_URL=         # (Default: empty) to hide origin server's IP address when fetching image

# Segment deduplication - detects repeated openings/endings/branding bumpers,
# extracts one canonical copy, and deletes the redundant vectors from Milvus
# DEDUP_ENABLED=1          # (Default: 1) set to 0 to disable the whole flow
# DEDUP_MILVUS_READONLY=0  # (Default: 0) set to 1 to detect and record only, never write to Milvus
# BRANDING_PATH=           # (Default: $VIDEO_PATH/branding) one <name>.png + <name>.mp4 per bumper
# DEBUG_ENDPOINTS=         # (Default: empty) set to 1 to mount the unauthenticated /debug routes
# DEDUP_MIN_SUPPORT=3      # (Default: 3) episodes that must agree before a segment is accepted
# DEDUP_MAX_L2=20          # (Default: 20) L2 distance below which two frames are the same frame
# DEDUP_SAMPLE_INTERVAL=1  # (Default: 1) probe one frame every N seconds
# DEDUP_GAP_TOLERANCE=4    # (Default: 4) unmatched seconds tolerated inside a segment
# DEDUP_DELTA_BIN=0.25     # (Default: 0.25) resolution of the per-episode time offset histogram
# DEDUP_REFERENCES=3       # (Default: 3) episodes used as detection references
# DEDUP_PRUNE_MARGIN=0.5   # (Default: 0.5) seconds kept at both ends of every pruned range
# DEDUP_REDETECT_RATIO=1.5 # (Default: 1.5) re-detect once a series grew by this factor
# DEDUP_MAX_SEGMENTS_PER_TYPE=4 # (Default: 4) a series may change its opening at a cour boundary
# DEDUP_MAX_DETECT_ROUNDS=12    # (Default: 12) detection rounds per type, including empty ones
# DEDUP_OPENING_MIN=45     # (Default: 45)
# DEDUP_OPENING_MAX=180    # (Default: 180)
# DEDUP_ENDING_MIN=45      # (Default: 45)
# DEDUP_ENDING_MAX=300     # (Default: 300)
# DEDUP_BRANDING_MIN=4.5   # (Default: 4.5)
# DEDUP_BRANDING_MAX=30    # (Default: 30)
# DEDUP_BRANDING_SEARCH_WINDOW=15  # (Default: 15) a bumper has to start this early in the file
# DEDUP_BRANDING_DISCOVERY_ROUNDS=10 # (Default: 10) re-queries needed to see past DEDUP_SEARCH_LIMIT

# Database setting
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=postgres

# Milvus setting
MILVUS_ADDR=http://localhost:19530
MILVUS_TOKEN=root:Milvus

# Email setting for user accounts, leave empty to disable
# EMAIL_SMTP=smtp.ethereal.email
# EMAIL_SMTP_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM

# Sponsor setting, leave empty to disable
# WEBHOOK_GITHUB_SECRET=
# WEBHOOK_PATREON_SECRET=

# Notification setting, leave empty to disable
# DISCORD_URL=
# TELEGRAM_ID=
# TELEGRAM_URL=
